#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    combos {
        compatible = "zmk,combos";

        Caps {
            bindings = <&kp CAPS>;
            key-positions = <16 19>;
        };
    };

    behaviors {
        mtd: ModTapDelay {
            compatible = "zmk,behavior-hold-tap";
            label = "Mod/Tap Delayed";
            #binding-cells = <2>;
            bindings = <&kp>, <&kpd>;

            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <200>;
            quick-tap-ms = <200>;
        };

        ltd: LayerTapDelay {
            compatible = "zmk,behavior-hold-tap";
            label = "Layer/Tap Delayed";
            bindings = <&mo>, <&kpd>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };
    };

    macros {
        mail: mail {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp F &kp A &kp B &kp R &kp I &kp Z &kp I &kp O &kp DOT &kp C &kp O &kp R &kp T &kp E &kp S &kp I &kp N1 &kp N7 &kp N9 &kp AT &kp G &kp M &kp A &kp I &kp L &kp DOT &kp C &kp O &kp M>;
            label = "MAIL";
        };

        kpd: KeyPressDelay {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;       // delay between macro steps
            tap-ms = <30>;      // hold each tap for x ms
            // forward the macro's 1st param into &kp:

            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;
        };

        macros {
            umlaut_a: umlaut_a {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <40>;
                bindings = <&kp DOUBLE_QUOTES &kp A>;
            };

            umlaut_o: umlaut_o {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <40>;
                bindings = <&kp DOUBLE_QUOTES &kp O>;
            };

            umlaut_u: umlaut_u {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <40>;
                bindings = <&kp DOUBLE_QUOTES &kp U>;
            };
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Alpha {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Alpha";
            bindings = <
&none  &kp Q                &kp W            &kp E          &kp R              &kp T             &kp Z             &kp U               &mtd LS(I) I   &kp O            &kp P                   &mail
&none  &mtd LEFT_COMMAND A  &mtd LEFT_ALT S  &mtd LCTRL D   &mtd LEFT_SHIFT F  &kp G             &kp H             &mtd RIGHT_SHIFT J  &mtd RCTRL K   &mtd LEFT_ALT L  &mtd LEFT_COMMAND SEMI  &umlaut_a
&none  &kp Y                &kp X            &kp C          &kp V              &kp B             &kp N             &kp M               &kp COMMA      &kp DOT          &kp MINUS               &to 1
                                             &ltd 4 ESCAPE  &ltd 2 SPACE       &mtd LCTRL TAB    &mtd RSHFT ENTER  &ltd 3 BACKSPACE    &ltd 2 DELETE
            >;

            label = "Alpha";
        };

        Gaming {
            display-name = "Gaming";
            bindings = <
&kp LEFT_ALT    &kp Q  &kp W  &kp E       &kp R      &kp T             &kp Z             &kp U               &mtd LS(I) I   &kp O        &kp P                   &none
&kp LEFT_SHIFT  &kp A  &kp S  &kp D       &kp F      &kp G             &kp H             &mtd RIGHT_SHIFT J  &mtd RCTRL K   &mtd LALT L  &mtd LEFT_COMMAND SEMI  &none
&kp LCTRL       &kp Y  &kp X  &kp C       &kp V      &kp B             &kp N             &kp M               &kp COMMA      &kp DOT      &kp MINUS               &to 0
                              &ltd 4 ESC  &kp SPACE  &mtd LCTRL TAB    &mtd RSHFT ENTER  &ltd 3 BACKSPACE    &ltd 2 DELETE
            >;

            label = "Gaming";
        };

        Numbers {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Numbers";
            bindings = <
&none  &kp N1      &kp N2            &kp N3      &kp N4      &kp N5        &kp N6    &kp N7         &kp N8       &kp N9     &kp N0  &none
&none  &kp LC(N1)  &kp LC(N2)        &kp LC(N3)  &kp LC(N4)  &kp LC(N5)    &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT  &none   &none
&none  &kp LG(N1)  &kp LG(NUMBER_2)  &kp LG(N3)  &kp LG(N4)  &kp LG(N5)    &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &none   &none
                                     &trans      &trans      &trans        &trans    &trans         &trans
            >;

            label = "Numbers";
        };

        Symbols {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Symbols";
            bindings = <
&none  &kp PLUS       &kp DOUBLE_QUOTES  &kp ASTERISK    &kp SINGLE_QUOTE  &kp PRCNT    &kp AMPS         &kp SLASH     &kp PIPE         &kp BACKSLASH      &kp EQUAL       &none
&none  &kp LT         &kp LEFT_BRACKET   &kp LEFT_BRACE  &kp LS(LPAR)      &kp GRAVE    &kp EXCLAMATION  &kp LS(RPAR)  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp LS(GT)      &none
&none  &kp BACKSLASH  &kp AT             &kp HASH        &kp CARET         &kp TILDE    &kp DOLLAR       &kp QUESTION  &kp SEMI         &kp LS(SEMI)       &kp UNDERSCORE  &none
                                         &trans          &trans            &trans       &trans           &trans        &trans
            >;

            label = "Symbols";
        };

        Functions {
            display-name = "Functions";
            bindings = <
&none       &kp F1           &kp F2                           &kp F3           &kp F4           &kp F5             &kp F6          &kp F7          &kp F8        &kp F9           &kp F10    &kp F11
&bt BT_CLR  &bt BT_SEL 0     &bt BT_SEL 1                     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4       &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &mkp LCLK  &kp F12
&none       &rgb_ug RGB_TOG  &rgb_ug RGB_COLOR_HSB(0,100,50)  &rgb_ug RGB_BRI  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI    &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &mkp RCLK  &kp F13
                                                              &trans           &trans           &trans             &trans          &trans          &trans
            >;

            label = "Functions";
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
